{
  "name": "ly-nav",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "cross-env PORT=3000 rsbuild dev --env-mode development --config build/rsbuild.dev.config.ts",
    "build": "pnpm typecheck && pnpm build:prod",
    "build:prod": "rsbuild build --env-mode production --config build/rsbuild.prod.config.ts",
    "deploy": "pnpm build && gh-pages -d dist --nojekyll",
    "preview": "rsbuild preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rsbuild/core": "2.1.13",
    "@rsbuild/plugin-image-compress": "1.3.4",
    "@rsbuild/plugin-sass": "2.0.1",
    "@rsbuild/plugin-vue": "2.0.1",
    "@types/node": "26.2.0",
    "compression-webpack-plugin": "12.0.0",
    "cross-env": "10.1.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "gh-pages": "6.3.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.6",
    "sass": "1.103.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.1",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.10"
  }
}
